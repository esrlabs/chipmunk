[Desktop Entry]
Name=Chipmunk
Comment=Log viewer tool
GenericName=Log viewer tool
Exec=chipmunk files %F
Icon=chipmunk
Type=Application
Categories=Utility;Development;
Actions=new-empty-window;
Keywords=chipmunk;log;viewer;trace;dlt;
MimeType=text/plain;text/x-log;application/vnd.tcpdump.pcap;application/x-pcapng;application/x-dlt;

[Desktop Action new-empty-window]
Name=New Empty Window
Exec=chipmunk
Icon=chipmunk
